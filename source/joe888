        for zone, offset in self.supported_timezones.items():
            adjusted = (now + timedelta(hours=offset)).strftime("%H:%M:%S")
            self.clock[zone] = adjusted
        clock_display = " | ".join([f"{k}: {v}" for k, v in self.clock.items()])
        print(f"[CLOCK] {clock_display}")

